# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/s-express
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/s-express

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Payment Configuration (Optional - no API keys needed)
# PAYMENT_METHOD can be: 'mock' (simulates payments) or 'cod' (cash on delivery)
PAYMENT_METHOD=mock

# Email Configuration (Optional)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Frontend URL
FRONTEND_URL=http://localhost:3000
